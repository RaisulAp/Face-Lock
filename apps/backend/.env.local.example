# Template untuk menjalankan backend LANGSUNG DI HOST (Hybrid
# Development — lihat deploy/HYBRID_DEV.md), bukan lewat Docker.
#
# Setup:
#   1. copy jadi apps/backend/.env.local (sudah di-gitignore)
#   2. cocokkan POSTGRES_PASSWORD dan POSTGRES_PORT dengan isi deploy/.env
#      yang sebenarnya kamu pakai (nilainya BISA BEDA dari default di sini —
#      cek `deploy/.env` dulu sebelum jalan)
#   3. `make dev-backend` (atau scripts/dev-backend.ps1) akan meng-export file ini
#      lalu menjalankan `go run ./cmd/api`
#
# config.Load() (internal/config/config.go) membaca murni dari environment
# process — file ini TIDAK dibaca otomatis oleh Go, harus di-export dulu
# oleh helper script/Makefile target di atas.

APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug

# Postgres jalan di Docker (`make dev-db`), port di-publish ke host.
# ⚠️ Ganti <password> dan port di bawah ini dengan POSTGRES_PASSWORD /
# POSTGRES_PORT yang SEBENARNYA ada di deploy/.env — jangan asumsikan 5433,
# beberapa mesin dev sudah memakai port lain untuk menghindari bentrok.
DATABASE_URL=postgres://faceclock:<password>@localhost:5433/faceclock?sslmode=disable
DATABASE_MAX_CONNS=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_BYTES=10485760

# Path relatif ke folder apps/faceclock-api (bukan /data/uploads seperti di
# container) supaya tidak perlu izin admin untuk menulis ke root drive.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# faceclock-inference dinyalakan on-demand lewat `make ai-up` (lihat
# deploy/HYBRID_DEV.md). Kalau service ini mati, endpoint non-wajah tetap
# jalan normal — health.Handler hanya menandai /readyz "degraded", dan
# request ke endpoint yang benar-benar butuh wajah akan gagal dengan error
# HTTP biasa (bukan crash), karena inference.Client.* mengembalikan `error`
# lewat jalur pemanggilan HTTP standar, bukan panic.
INFERENCE_BASE_URL=http://localhost:8000
INFERENCE_TOKEN=
INFERENCE_TIMEOUT_MS=6000

# Kosong = otomatis pakai secret dev bawaan (config.go, hanya berlaku saat
# APP_ENV=development).
JWT_SECRET=

# Seeder (Fase 1) — berjalan otomatis tiap start selama APP_ENV=development.
SEED_ADMIN_EMAIL=admin@faceclock.local
SEED_ADMIN_PASSWORD=

VERSION=0.1.0
COMMIT=local-host
BUILD_TIME=
