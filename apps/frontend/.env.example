# Dikosongkan (default) agar request pakai path relatif lewat proxy Vite
# (/api -> BACKEND_URL). Isi hanya kalau sengaja mau bypass proxy dan
# memanggil faceclock-api langsung lintas origin.
VITE_API_BASE_URL=

# Target proxy /api saat `npm run dev` (dibaca vite.config.ts via
# process.env, TIDAK diekspos ke client — makanya tanpa prefix VITE_).
# - Jalan di Docker (faceclock-web container): biarkan default
#   (http://faceclock-api:8080, nama service di network compose).
# - Hybrid Development, faceclock-web dijalankan lewat `npm run dev` di
#   host: faceclock-api juga jalan di host, jadi arahkan ke localhost.
BACKEND_URL=http://localhost:8080
