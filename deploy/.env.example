# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=faceclock
POSTGRES_PASSWORD=              # WAJIB diisi
POSTGRES_DB=faceclock
POSTGRES_PORT=5433

# ── faceclock-api ─────────────────────────────────────────
APP_ENV=development             # development | staging | production
APP_PORT=8080
APP_LOG_LEVEL=debug             # debug | info | warn | error
DATABASE_URL=postgres://faceclock:${POSTGRES_PASSWORD}@postgres:5432/faceclock?sslmode=disable
DATABASE_MAX_CONNS=10
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_BYTES=10485760

# Storage foto (Fase 3/4)
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# Object storage S3/MinIO — dicatat sejak Fase 0 (REV-INF-03), TIDAK dipakai
# sampai D13 (Fase 3, penyimpanan foto referensi) dikonfirmasi. MinIO belum
# ditambahkan ke docker-compose.yml; lihat gap yang dilaporkan di DONE-Fase-0.md.
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION=
# STORAGE_S3_BUCKET_FACE=
# STORAGE_S3_BUCKET_ATTENDANCE=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_SSE=

# Inference (dipakai penuh mulai Fase 2)
INFERENCE_BASE_URL=http://faceclock-inference:8000
INFERENCE_TOKEN=                # WAJIB diisi mulai Fase 2
INFERENCE_TIMEOUT_MS=6000

# Port host untuk faceclock-inference saat dipublish oleh
# deploy/docker-compose.override.yml (Hybrid Development / `make ai-up`).
# Tidak dipakai oleh docker-compose.yml (base) — di sana service ini sengaja
# tanpa `ports:`.
INFERENCE_PORT=8000

# JWT (dipakai mulai Fase 1) — biarkan kosong di Fase 0
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Seeder (Fase 1)
SEED_ADMIN_EMAIL=admin@faceclock.local
SEED_ADMIN_PASSWORD=            # Di development otomatis 'Faceclock123!' bila kosong. Di staging/prod WAJIB diisi.

# Build metadata (diisi otomatis oleh `make up` lewat -ldflags; boleh
# dikosongkan untuk override manual)
VERSION=0.1.0
COMMIT=
BUILD_TIME=

# ── faceclock-inference ───────────────────────────────────
FACE_ENGINE_TOKEN=              # sama dengan INFERENCE_TOKEN

# ── faceclock-web ─────────────────────────────────────────
# Dikosongkan agar web menggunakan reverse proxy Vite (/api -> faceclock-api:8080)
VITE_API_BASE_URL=
